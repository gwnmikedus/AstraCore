{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astracore",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "astracore"
      ],
      "port": 8765,
      "env": {
        "ASTRACORE_RELOAD": "1"
      }
    },
    {
      "name": "astracore-local-8766",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "astracore"
      ],
      "port": 8766,
      "env": {
        "ASTRACORE_MODE": "local",
        "ASTRACORE_PORT": "8766",
        "ASTRACORE_PUBLIC_URL": "http://localhost:8766",
        "ASTRACORE_RELOAD": "1"
      }
    }
  ]
}
