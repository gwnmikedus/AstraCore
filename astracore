#!/bin/bash
# Astracore on/off switch.
#
#   ./astracore start          local mode  (http://localhost:8765, .env.local, data/local), runs this checkout
#   ./astracore start --prod   production  (public URL through the Cloudflare tunnel, .env.production, data/production),
#                              runs the pinned production checkout
#   ./astracore deploy [ref]   pin production to a commit on origin/main (default: its tip) and restart it
#   ./astracore rollback       pin production back to the previously deployed commit and restart it
#   ./astracore mark-released <from> [to]   sync status:released for the PRs between two commits (deploy does this)
#   ./astracore stop           stops the tunnel first (visitors get the offline page), then the app
#   ./astracore restart [--prod]
#   ./astracore status [--json]   (--json: machine-readable, for AstraCore Control.app)
#   ./astracore logs           follow the app (and tunnel) logs
#
# The app listens on 127.0.0.1 only; in production the tunnel is the only way in.
# Production code lives in its own git worktree (default: <this folder>-production, detached at the deployed
# commit), so edits, branches and pulls in this checkout never reach the live site. Env files, data/, logs and
# the virtualenv stay here. Every deploy is recorded in data/deploys.log.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROD_CODE="${ASTRACORE_PROD_CHECKOUT:-$ROOT-production}"
DEPLOY_LOG="$ROOT/data/deploys.log"
PY="$ROOT/.venv/bin/python"
RUN="$ROOT/data/run"
LOGS="$ROOT/data/logs"
PORT=8765
mkdir -p "$RUN" "$LOGS"
chmod 700 "$RUN" 2>/dev/null || true
export ASTRACORE_HOME="$ROOT"

say()  { printf '%s\n' "$*"; }
die()  { printf 'astracore: %s\n' "$*" >&2; exit 1; }
alive() { [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null; }
env_value() { grep -E "^$2=" "$1" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d "\"' " || true; }
port_for() { local v; v=$(env_value "$1" ASTRACORE_PORT); echo "${v:-8765}"; }
url_for()  { local v; v=$(env_value "$1" ASTRACORE_PUBLIC_URL); echo "${v:-http://localhost:$PORT}"; }

cloudflared_bin() {
  if [[ -x "$ROOT/bin/cloudflared" ]]; then echo "$ROOT/bin/cloudflared"
  elif command -v cloudflared >/dev/null 2>&1; then command -v cloudflared
  else return 1; fi
}

wait_health() {
  local i
  for i in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then return 0; fi
    alive "$RUN/app.pid" || return 1
    sleep 0.5
  done
  return 1
}

stop_pid() {   # stop_pid <pidfile> <name>
  local f="$1" name="$2" pid i
  if alive "$f"; then
    pid=$(cat "$f")
    kill -TERM "$pid" 2>/dev/null || true
    for i in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
    say "Stopped $name."
  fi
  rm -f "$f"
}

cmd_start() {
  local mode="local"
  [[ "${1:-}" == "--prod" || "${1:-}" == "--production" ]] && mode="production"
  [[ -x "$PY" ]] || die "No virtualenv. Run: python3 -m venv .venv && .venv/bin/pip install -e ."
  if alive "$RUN/app.pid"; then
    die "Already running ($(cat "$RUN/mode" 2>/dev/null || echo '?') mode). Run ./astracore stop first."
  fi
  local envfile="$ROOT/.env.$mode"
  [[ -f "$envfile" ]] || die "Missing .env.$mode (see README)."
  chmod 600 "$envfile" 2>/dev/null || true
  PORT=$(port_for "$envfile")
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Port $PORT is already in use (another Astracore or app?). Free it first."
  fi
  local code="$ROOT"
  if [[ "$mode" == "production" ]]; then
    code="$PROD_CODE"
    [[ -f "$code/src/astracore/__init__.py" ]] || die "No production checkout at $code. Run: ./astracore deploy"
  fi
  export PYTHONPATH="$code/src"
  export ASTRACORE_MODE="$mode"
  "$PY" -m astracore.ops check || die "Not starting $mode mode."
  "$PY" -m astracore.ops backup
  "$PY" -m astracore.ops migrate

  unset ASTRACORE_COMMIT
  if [[ -z "$(git -C "$code" status --porcelain 2>/dev/null)" ]]; then
    ASTRACORE_COMMIT=$(git -C "$code" rev-parse HEAD 2>/dev/null) || ASTRACORE_COMMIT=""
    export ASTRACORE_COMMIT
  fi

  say "Starting Astracore ($mode, $(git -C "$code" describe --tags --always --dirty 2>/dev/null || echo 'no git'))…"
  "$PY" "$ROOT/scripts/launch_service.py" --cwd "$code" --log "$LOGS/app-$mode.out" \
    --pid "$RUN/app.pid" -- "$PY" -m astracore
  echo "$mode" >"$RUN/mode"
  if ! wait_health; then
    stop_pid "$RUN/app.pid" "app"
    die "The app didn't come up. See: tail -n 50 $LOGS/app-$mode.out"
  fi

  if [[ "$mode" == "production" ]]; then
    local cf token
    cf=$(cloudflared_bin) || { stop_pid "$RUN/app.pid" "app"; die "cloudflared not found (expected bin/cloudflared)."; }
    token=$(env_value "$envfile" CLOUDFLARE_TUNNEL_TOKEN)
    [[ -n "$token" ]] || { stop_pid "$RUN/app.pid" "app"; die "CLOUDFLARE_TUNNEL_TOKEN is empty in .env.production."; }
    # The token goes in through the environment (TUNNEL_TOKEN), so it never shows up in `ps`.
    if ! TUNNEL_TOKEN="$token" "$PY" "$ROOT/scripts/launch_service.py" --cwd "$code" --log "$LOGS/tunnel.out" \
      --pid "$RUN/tunnel.pid" -- "$cf" tunnel --no-autoupdate run; then
      unset token
      stop_pid "$RUN/app.pid" "app"
      die "The tunnel couldn't start. See: tail -n 50 $LOGS/tunnel.out"
    fi
    unset token
    sleep 2
    alive "$RUN/tunnel.pid" || { stop_pid "$RUN/app.pid" "app"; die "The tunnel stopped right away. See: tail -n 50 $LOGS/tunnel.out"; }
  fi
  say "Astracore is up: $(url_for "$envfile")"
}

cmd_stop() {
  local any=0
  if alive "$RUN/tunnel.pid" || alive "$RUN/app.pid"; then any=1; fi
  stop_pid "$RUN/tunnel.pid" "tunnel"
  stop_pid "$RUN/app.pid" "app"
  rm -f "$RUN/mode"
  [[ $any == 1 ]] || say "Astracore wasn't running."
}

cmd_status() {
  local mode; mode=$(cat "$RUN/mode" 2>/dev/null || echo "-")
  if alive "$RUN/app.pid"; then
    PORT=$(port_for "$ROOT/.env.$mode")
    if curl -fsS "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
      say "App:    running ($mode mode, pid $(cat "$RUN/app.pid"), healthy)"
    else
      say "App:    running ($mode mode, pid $(cat "$RUN/app.pid")) but /healthz doesn't answer"
    fi
    say "URL:    $(url_for "$ROOT/.env.$mode")"
  else
    say "App:    stopped"
  fi
  if alive "$RUN/tunnel.pid"; then say "Tunnel: running (pid $(cat "$RUN/tunnel.pid"))"; else say "Tunnel: stopped"; fi
  if [[ -e "$PROD_CODE/.git" ]]; then
    local dirty=""
    [[ -z "$(git -C "$PROD_CODE" status --porcelain 2>/dev/null)" ]] || dirty=" (edited by hand! the next deploy discards that)"
    say "Build:  $(git -C "$PROD_CODE" describe --tags --always 2>/dev/null) $(git -C "$PROD_CODE" log -1 --format='%h %s' 2>/dev/null)$dirty"
    local behind; behind=$(git -C "$ROOT" rev-list --count "$(prod_commit)..origin/main" 2>/dev/null || echo '?')
    say "        $behind merged commit(s) on origin/main not deployed (as of the last fetch)"
  else
    say "Build:  no production checkout yet (./astracore deploy)"
  fi
}

prod_commit() { git -C "$PROD_CODE" rev-parse HEAD 2>/dev/null || true; }

cmd_status_json() {   # the same facts as cmd_status, as one JSON object (no fetch: "undeployed" is as of the last fetch)
  local mode="" app_pid="" healthy=0 url="" tunnel_pid="" checkout=0 commit="" describe="" subject="" dirty=0 undeployed=""
  if alive "$RUN/app.pid"; then
    mode=$(cat "$RUN/mode" 2>/dev/null || echo "")
    app_pid=$(cat "$RUN/app.pid")
    PORT=$(port_for "$ROOT/.env.$mode")
    curl -fsS --max-time 3 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1 && healthy=1
    url=$(url_for "$ROOT/.env.$mode")
  fi
  alive "$RUN/tunnel.pid" && tunnel_pid=$(cat "$RUN/tunnel.pid")
  if [[ -e "$PROD_CODE/.git" ]]; then
    checkout=1
    commit=$(prod_commit)
    describe=$(git -C "$PROD_CODE" describe --tags --always 2>/dev/null || true)
    subject=$(git -C "$PROD_CODE" log -1 --format='%s' 2>/dev/null || true)
    [[ -z "$(git -C "$PROD_CODE" status --porcelain 2>/dev/null)" ]] || dirty=1
    undeployed=$(git -C "$ROOT" rev-list --count "$commit..origin/main" 2>/dev/null || true)
  fi
  local py="$PY"; [[ -x "$py" ]] || py=python3
  S_MODE="$mode" S_APP_PID="$app_pid" S_HEALTHY="$healthy" S_URL="$url" S_TUNNEL_PID="$tunnel_pid" \
  S_PROD_URL="$(url_for "$ROOT/.env.production")" S_LOCAL_URL="$(url_for "$ROOT/.env.local")" \
  S_CHECKOUT="$checkout" S_COMMIT="$commit" S_DESCRIBE="$describe" S_SUBJECT="$subject" S_DIRTY="$dirty" \
  S_UNDEPLOYED="$undeployed" S_HOME="$ROOT" S_PROD_CODE="$PROD_CODE" "$py" -c '
import json, os
e = os.environ.get
num = lambda k: int(e(k)) if (e(k) or "").isdigit() else None
print(json.dumps({
    "home": e("S_HOME"),
    "app": {"running": bool(e("S_APP_PID")), "mode": e("S_MODE") or None, "pid": num("S_APP_PID"),
            "healthy": e("S_HEALTHY") == "1", "url": e("S_URL") or None},
    "tunnel": {"running": bool(e("S_TUNNEL_PID")), "pid": num("S_TUNNEL_PID")},
    "urls": {"production": e("S_PROD_URL"), "local": e("S_LOCAL_URL")},
    "production": {"checkout": e("S_PROD_CODE"), "exists": e("S_CHECKOUT") == "1", "commit": e("S_COMMIT") or None,
                   "build": e("S_DESCRIBE") or None, "subject": e("S_SUBJECT") or None,
                   "edited": e("S_DIRTY") == "1", "undeployed": num("S_UNDEPLOYED")},
}))'
}

pin_production() {   # pin_production <sha>: put the production checkout on exactly that commit
  local sha="$1"
  if [[ -e "$PROD_CODE/.git" ]]; then
    # --force + clean: whatever was changed in there by hand is discarded; production is the commit, nothing else.
    git -C "$PROD_CODE" checkout --quiet --force --detach "$sha"
    git -C "$PROD_CODE" clean --quiet -fd
  else
    [[ -e "$PROD_CODE" ]] && die "$PROD_CODE exists but isn't a git worktree; move it away first."
    git -C "$ROOT" worktree add --quiet --detach "$PROD_CODE" "$sha"
  fi
}

restart_production() {
  if alive "$RUN/app.pid" && [[ "$(cat "$RUN/mode" 2>/dev/null)" != "production" ]]; then
    die "Local mode is running. Stop it first (./astracore stop); production uses the same port."
  fi
  cmd_stop >/dev/null
  # A separate process, so `set -e` still applies to every startup step (it's off inside an `if` condition).
  "$ROOT/astracore" start --prod
}

cmd_deploy() {   # cmd_deploy [ref] [--rollback]
  local ref="${1:-origin/main}" note="${2:-deploy}" sha prev
  git -C "$ROOT" fetch --quiet --tags origin || die "git fetch failed."
  sha=$(git -C "$ROOT" rev-parse --verify --quiet "$ref^{commit}") || die "Unknown commit or ref: $ref"
  git -C "$ROOT" merge-base --is-ancestor "$sha" origin/main ||
    die "$ref ($(git -C "$ROOT" rev-parse --short "$sha")) isn't on origin/main. Only merged, reviewed commits go to production."
  git -C "$ROOT" grep --quiet ASTRACORE_HOME "$sha" -- src/astracore/config.py ||
    die "$ref predates pinned production deploys (its config can't find data/ here). Deploy a newer commit."
  prev=$(prod_commit)
  if [[ -n "$prev" ]] && ! git -C "$ROOT" diff --quiet "$prev" "$sha" -- pyproject.toml requirements.txt; then
    say "Note: dependencies changed since the running build. If startup fails, run: .venv/bin/pip install -r $PROD_CODE/requirements.txt"
  fi
  say "Pinning production to $(git -C "$ROOT" log -1 --format='%h %s' "$sha")"
  pin_production "$sha"
  if restart_production; then
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" \
      "$(git -C "$PROD_CODE" describe --tags --always 2>/dev/null)" "$note" >>"$DEPLOY_LOG"
    say "Deployed. Recorded in data/deploys.log."
    mark_released "$prev" "$sha"
  elif [[ -n "$prev" && "$prev" != "$sha" ]]; then
    say "The new build didn't come up. Putting $(git -C "$ROOT" rev-parse --short "$prev") back…"
    pin_production "$prev"
    restart_production || die "The previous build didn't come up either. See: tail -n 50 $LOGS/app-production.out"
    die "Deploy of $(git -C "$ROOT" rev-parse --short "$sha") failed; production is back on the previous build."
  else
    die "Production didn't come up. See: tail -n 50 $LOGS/app-production.out"
  fi
}

# status:released means "closed and live in production" (docs/releases.md#issue-labels). After a deploy, the issues
# closed by the pull requests that just went live get it; a rollback takes it off what it removes from production.
# Best effort: GitHub being unreachable never fails a deploy.
mark_released() {   # mark_released <from> <to>
  local from to add=1 range prs pr issues issue gh
  from=$(git -C "$ROOT" rev-parse --verify --quiet "${1:-}^{commit}" 2>/dev/null) || return 0
  to=$(git -C "$ROOT" rev-parse --verify --quiet "${2:-}^{commit}" 2>/dev/null) || return 0
  [[ "$from" != "$to" ]] || return 0
  if git -C "$ROOT" merge-base --is-ancestor "$from" "$to"; then range="$from..$to"
  elif git -C "$ROOT" merge-base --is-ancestor "$to" "$from"; then range="$to..$from"; add=0
  else return 0; fi
  gh=$(command -v gh 2>/dev/null || echo "$HOME/.local/bin/gh")
  if [[ ! -x "$gh" ]]; then say "Note: gh not found, so status:released wasn't updated. Run: ./astracore mark-released $1 $2"; return 0; fi
  prs=$(git -C "$ROOT" log --format=%s "$range" | sed -n 's/.*(#\([0-9][0-9]*\))$/\1/p' || true)
  for pr in $prs; do
    if ! issues=$(cd "$ROOT" && "$gh" pr view "$pr" --json closingIssuesReferences --jq '.closingIssuesReferences[].number' 2>/dev/null); then
      say "Note: couldn't read #$pr on GitHub; status:released not updated for it."; continue
    fi
    for issue in $issues; do
      if [[ $add == 1 ]]; then
        (cd "$ROOT" && "$gh" issue edit "$issue" --add-label status:released >/dev/null 2>&1) && say "Released: #$issue (live through #$pr)"
      else
        (cd "$ROOT" && "$gh" issue edit "$issue" --remove-label status:released >/dev/null 2>&1) && say "No longer released: #$issue (#$pr rolled back)"
      fi
    done
  done
  return 0
}

cmd_rollback() {
  local current prev
  current=$(prod_commit)
  [[ -f "$DEPLOY_LOG" ]] || die "No deploys recorded yet."
  # The most recent recorded deploy whose commit differs from the running one.
  prev=$(awk -F'\t' -v cur="$current" '$2 != cur { last = $2 } END { print last }' "$DEPLOY_LOG")
  [[ -n "$prev" ]] || die "No earlier deploy to roll back to."
  say "Rolling back from $(git -C "$ROOT" rev-parse --short "$current" 2>/dev/null || echo '?') to $(git -C "$ROOT" rev-parse --short "$prev")."
  say "Database migrations are not undone; a backup from before each start is in data/backups/production."
  cmd_deploy "$prev" rollback
}

cmd_logs() {
  local files=() f
  for f in "$LOGS"/app-*.out "$LOGS"/astracore-*.log "$LOGS"/tunnel.out; do [[ -f "$f" ]] && files+=("$f"); done
  [[ ${#files[@]} -gt 0 ]] || die "No logs yet."
  tail -n 60 -F "${files[@]}"
}

case "${1:-}" in
  start)   shift; cmd_start "$@" ;;
  stop)    cmd_stop ;;
  restart) shift; cmd_stop; cmd_start "$@" ;;
  deploy)  shift; cmd_deploy "${1:-origin/main}" ;;
  rollback) cmd_rollback ;;
  mark-released) shift; [[ -n "${1:-}" ]] || die "Usage: ./astracore mark-released <from> [to]"; mark_released "$1" "${2:-origin/main}" ;;
  status)  if [[ "${2:-}" == "--json" ]]; then cmd_status_json; else cmd_status; fi ;;
  logs)    cmd_logs ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
