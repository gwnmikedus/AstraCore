# Copy to .env.local (or .env.production), fill in, chmod 600. Never commit the copy.
ASTRACORE_MODE=local
ASTRACORE_PUBLIC_URL=http://localhost:8765
ASTRACORE_PORT=8765
ASTRACORE_DATA=data/local

# EVE application for this mode (developers.eveonline.com); the callback must match exactly
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8765/auth/callback

# Fernet key for EVE tokens (back it up!) and the session secret
ASTRACORE_TOKEN_KEY=
ASTRACORE_SESSION_SECRET=

# Comma-separated character IDs whose profile is the admin
ASTRACORE_ADMIN_CHARACTER_IDS=

# Production only: invite list (character / corporation / alliance IDs) and the tunnel token
ASTRACORE_ALLOWED_CHARACTERS=
ASTRACORE_ALLOWED_CORPS=
ASTRACORE_ALLOWED_ALLIANCES=
CLOUDFLARE_TUNNEL_TOKEN=

# Optional
# ASTRACORE_SOLVE_CONCURRENCY=2

# GitHub community integration: install an Issues read/write GitHub App on this repository only.
# Keep its PEM key outside tracked files, chmod 600. The webhook URL is
# https://your-site/api/community/github/webhook, subscribed to Issues events.
ASTRACORE_GITHUB_REPOSITORY=gwnmikedus/AstraCore
ASTRACORE_GITHUB_APP_ID=
ASTRACORE_GITHUB_INSTALLATION_ID=
ASTRACORE_GITHUB_PRIVATE_KEY_PATH=
ASTRACORE_GITHUB_WEBHOOK_SECRET=
# ASTRACORE_COMMUNITY_POLL_SECONDS=300
# Optional alternative: a repository-scoped token with Issues read/write only.
# ASTRACORE_GITHUB_TOKEN=
